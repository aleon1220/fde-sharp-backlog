<Project>
  <PropertyGroup>
    <!-- Deterministic NuGet lockfiles for RID-agnostic restores; redirect RID-specific lockfile into obj/ so repo packages.lock.json stays RID-agnostic (Issue #57, #59) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true' and '$(RuntimeIdentifier)' == ''">true</RestoreLockedMode>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/obj/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>

    <!-- Optional upstream caching proxy & local fallback feeds (skipped when restore script passes a managed config) -->
    <RestoreSources Condition="'$(SBA_NUGET_CONFIG_MANAGED)' != 'true' and '$(NUGET_PROXY_FEED_URL)' != '' and '$(NUGET_PROXY_ONLY)' == 'true'">$(NUGET_PROXY_FEED_URL)</RestoreSources>
    <RestoreAdditionalProjectSources Condition="'$(SBA_NUGET_CONFIG_MANAGED)' != 'true' and '$(NUGET_PROXY_FEED_URL)' != '' and '$(NUGET_PROXY_ONLY)' != 'true'">$(NUGET_PROXY_FEED_URL);$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
    <RestoreAdditionalProjectSources Condition="'$(SBA_NUGET_CONFIG_MANAGED)' != 'true' and '$(NUGET_FALLBACK_FEED_DIR)' != '' and Exists('$(NUGET_FALLBACK_FEED_DIR)')">$(RestoreAdditionalProjectSources);$(NUGET_FALLBACK_FEED_DIR)</RestoreAdditionalProjectSources>
    <RestoreFallbackFolders Condition="'$(SBA_NUGET_CONFIG_MANAGED)' != 'true' and '$(NUGET_FALLBACK_PACKAGES_DIR)' != '' and Exists('$(NUGET_FALLBACK_PACKAGES_DIR)')">$(RestoreFallbackFolders);$(NUGET_FALLBACK_PACKAGES_DIR)</RestoreFallbackFolders>
    <RestoreFallbackFolders Condition="'$(SBA_NUGET_CONFIG_MANAGED)' != 'true' and '$(NUGET_FALLBACK_PACKAGES_DIR)' == '' and Exists('$(MSBuildThisFileDirectory).nuget/fallback')">$(RestoreFallbackFolders);$(MSBuildThisFileDirectory).nuget/fallback</RestoreFallbackFolders>
  </PropertyGroup>
</Project>
